{
  "manifest_version": 3,
  "name": "AWG Browser Tunnel",
  "version": "1.0.0",
  "description": "Туннель AmneziaWG только для браузера, с разделением трафика по сайтам. Нужен локальный хелпер.",
  "homepage_url": "https://github.com/RoninOnis/amnezia-browser-vpn",
  "browser_specific_settings": {
    "gecko": {
      "id": "awgbv@0xoni.ru",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging",
    "tabs",
    "alarms"
  ],
  "background": {
    "scripts": [
      "lib/vpnparse.js",
      "background.js"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "AWG Browser Tunnel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
